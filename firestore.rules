rules_version = '2';
// 部署方式：Firebase Console → Firestore Database → 規則 → 貼上後發布
service cloud.firestore {
  match /databases/{database}/documents {

    // 庫存：任何人可讀（前台要顯示剩餘量）；
    // 寫入僅允許「扣減」或「回補」stock 欄位，且不得為負數。
    match /inventory/{size} {
      allow read: if true;
      allow create: if request.resource.data.stock is int
                    && request.resource.data.stock >= 0;
      allow update: if request.resource.data.stock is int
                    && request.resource.data.stock >= 0;
      allow delete: if false;
    }

    // 訂單：允許新增（學生訂購）與讀取。
    // ⚠ 這是「無登入」的輕量後台設定，任何人取得網址都能讀訂單。
    //    若在意隱私，請改為串接 Firebase Auth 並把 read 限制為管理員 uid。
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(
                         ['gradeClass','studentName','size','quantity','timestamp'])
                    && request.resource.data.studentName is string
                    && request.resource.data.studentName.size() > 0
                    && request.resource.data.studentName.size() <= 20
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity >= 1
                    // 金額欄位為選填（相容舊版快取的前端），但若有就必須正確
                    && (!('unitPrice' in request.resource.data)
                        || request.resource.data.unitPrice == 200)
                    && (!('subtotal' in request.resource.data)
                        || request.resource.data.subtotal ==
                           request.resource.data.quantity * 200)
                    && request.resource.data.gradeClass in
                       ['一甲','二甲','三甲','四甲','五甲','六甲']
                    && request.resource.data.size in
                       ['8號','9號','10號','XS','S','M','L','XL','2L','3XL'];
      allow update: if false;
      allow delete: if true;   // 管理老師刪單用；要更嚴格請改 false 並改用 Auth
    }
  }
}
